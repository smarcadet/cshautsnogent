---
import Layout from '../layouts/Layout.astro';
import Main from '../layouts/Main.astro';
import ProgressTracker from '../components/progress-tracker.astro';
import { getCollection } from "astro:content";
import { steps } from "../utils/travaux";

const baseUrl = import.meta.env.BASE_URL;

const travaux = await getCollection("travaux");

const chantierListe = travaux.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Suivi des travaux">
    <Main>

    <h1>Suivi des travaux</h1>
        
    {
      chantierListe.map((item) => {

        const currentStep =
          steps.indexOf(item.data.status);

        return (
          <hr />
          <article>

            <h2 class="pt-0">
              <a href={`${baseUrl}/suivi-des-travaux/${item.id}`}>
                {item.data.title}
              </a>
            </h2>

            <ProgressTracker
              status={item.data.status}
              blocked={item.data.blocked}
              showProgress={item.data.showProgress}
          />

            <p>{item.data.excerpt}</p>

          </article>
        );
      })
    }

    </Main>
</Layout>