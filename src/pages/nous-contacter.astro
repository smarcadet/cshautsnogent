---
import Layout from '../layouts/Layout.astro';
import Main from '../layouts/Main.astro';
---

<Layout title="Nous contacter">
	<Main>


<form action="https://api.web3forms.com/submit">

    <p>Tous les champs sont obligatoires</p>

    <input
      type="hidden"
      name="access_key"
      value="TA_CLE_WEB3FORMS"
    />

    <label for="nom">
        Nom
    </label>

    <input
      id="nom"
      name="first_name"
      type="text"
      required
    />

    <label for="prenom">
        Prénom
    </label>

    <input
      id="prenom"
      name="name"
      type="text"
      required
    />

    <label for="email">
        Email
    </label>

    <input
      id="email"
      type="email"
      name="email"
      type="email"
      required
    />

    <label for="message">
        Message
    </label>

    <textarea
      id="message"
      name="message"
      required
    ></textarea>

    <button type="submit">
        Envoyer
    </button>

</form>
</Main>
</Layout>