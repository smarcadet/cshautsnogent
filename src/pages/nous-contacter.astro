---
import Layout from '../layouts/Layout.astro';
import Main from '../layouts/Main.astro';
---

<Layout title="Nous contacter">
	<Main>

    <h1>Nous contacter</h1>

    <p>Une question, un signalement ou une suggestion concernant la résidence ? Le Conseil Syndical est à votre écoute. Les messages transmis via ce formulaire sont reçus par l'ensemble des membres du Conseil Syndical afin d'assurer un meilleur suivi des demandes.</p>

    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="form rounded-lg max-w-[80%] mx-auto bg-gray-100 border-2 border-(--secondary) px-8 py-1.5 pb-8"
    >

        <p class="italic text-base">Tous les champs sont obligatoires</p>

        <fieldset class="hidden">
          <legend>Méta données et connexion</legend>
          <input
            type="hidden"
            name="access_key"
            value="ea2d52be-cd1a-4e81-9b08-1ad0d2559b92"
          />

          <input
            type="hidden"
            name="subject"
            value="Message depuis le site des Hauts de Nogent"
          />

          <input
            type="hidden"
            name="from_name"
            value="Message de coproprietaire"
          />

          <input
            type="hidden"
            name="source"
            value="Formulaire de contact du site internet"
          />
        </fieldset>

        <fieldset>
          <legend>Civilité</legend>

          <label for="prenom">
            Prénom
          </label>

          <input
            id="prenom"
            name="prénom"
            type="text"
            autocomplete="given-name"
            required
          />

          <label for="nom">
              Nom
          </label>

          <input
            id="nom"
            name="nom"
            type="text"
            autocomplete="family-name"
            required
          />
        </fieldset>

        <fieldset>
          <legend>Localisation</legend>

          <label for="bat">
            Dans quel bâtiment êtes-vous ?
          </label>

          <select
            id="bat"
            name="bâtiment"
            required
          >
            <option value="">
              Sélectionnez votre bâtiment
            </option>

            <option>147 Boulevard de Strasbourg</option>
            <option>2 Allée des Epivans</option>
            <option>2 bis Allée des Epivans</option>
          </select>

          <label for="etage">
              À quel étage ?
          </label>

          <select
            id="etage"
            name="étage"
            required
          >
            <option value="">
              Sélectionnez votre étage
            </option>

            <option>RDC</option>
            <option>1er</option>
            <option>2ème</option>
            <option>3ème</option>
            <option>4ème</option>
            <option>5ème</option>
            <option>6ème</option>
          </select>
        </fieldset>
        
        <fieldset>
          <legend>Communication</legend>

          <label for="email">
            Renseignez votre email <span class="text-base"><em>(Pour pouvoir vous répondre)</em></span>
          </label>

          <input
            id="email"
            type="email"
            name="email"
            autocomplete="email"
            required
          />

          <label for="message">
              Votre message
          </label>

          <textarea
            id="message"
            name="message"
            required
          ></textarea>
        </fieldset>

        <input
          type="checkbox"
          name="botcheck"
          class="hidden"
          tabindex="-1"
          autocomplete="off"
        />

        <div class="flex justify-end"><button type="submit">Envoyer mon message <span aria-hidden="true">&rarr;</span></button></div>

    </form>
  </Main>
</Layout>