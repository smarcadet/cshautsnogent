---
import Layout from '../layouts/Layout.astro';
import Main from '../layouts/Main.astro';
---

<Layout title="Nous contacter">
	<Main>


<form action="https://api.web3forms.com/submit">

  <iframe width="640px" height="480px" src="https://forms.cloud.microsoft/Pages/ResponsePage.aspx?id=DQSIkWdsW0yxEjajBLZtrQAAAAAAAAAAAANAAbO7PVNUMVlFR0ExNldZN0NMMVFGWUpZS0hEUjQ0NC4u&embed=true" frameborder="0" marginwidth="0" marginheight="0" style="border: none; max-width:100%; max-height:100vh"></iframe>

    <input
      type="hidden"
      name="access_key"
      value="TA_CLE_WEB3FORMS"
    />

    <label for="nom">
        Nom
    </label>

    <input
      id="nom"
      name="name"
      required
    />

    <label for="email">
        Email
    </label>

    <input
      id="email"
      type="email"
      name="email"
      required
    />

    <label for="message">
        Message
    </label>

    <textarea
      id="message"
      name="message"
      required
    ></textarea>

    <button type="submit">
        Envoyer
    </button>

</form>
</Main>
</Layout>