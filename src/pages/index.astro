---
import Layout from '../layouts/Layout.astro';
import Main from '../layouts/Main.astro';
import { Image } from 'astro:assets';

import hero from '../assets/bat_epivans.jpeg';

import { getCollection } from "astro:content";

const baseUrl = import.meta.env.BASE_URL;
const actualites = await getCollection("actualites");

const dernieresActus = actualites
.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
.slice(0, 3);
---

<Layout title="Accueil" isHome={true}>
	<main id="main-content">
		<section class="relative h-130 overflow-hidden">
			<div class="text-white bg-black/55 absolute inset-0 z-10 flex content-center justify-center h-full flex-wrap">
				<div class="text-center pt-10">
					<h1 class="text-6xl font-sans font-black">Copropriété des Hauts Nogent</h1>
					<p class="text-2xl">Ensemble pour une résidence agréable à vivre</p>
				</div>
			</div>
			<Image
				src={hero}
				alt="Vue de la façade du bâtiment 2/2bis allée des Epivans"
				class="absolute inset-0 w-full h-full object-cover"
				loading="eager"
				widths={[640, 1024, 1440]}
				sizes="100vw"
			/>
		</section>

		<Main isHome={true}>
			<section>
				<p>
					<strong>Chers copropriétaires,</strong><br><br>
					ce site a pour vocation de vous informer en toute transparence sur les sujets qui concernent notre résidence : décisions votées en Assemblée Générale, les travaux en cours, les actions engagées et les principaux événements de la copropriété.
					Notre objectif est de permettre à chaque copropriétaire de mieux comprendre les actions menées au quotidien pour préserver et améliorer notre cadre de vie.
				</p>
				<p>
					Cet espace a également pour vocation de faciliter les échanges avec les copropriétaires. Vous pouvez nous signaler tout problème ou dysfonctionnement concernant les parties communes ou présentant un intérêt collectif pour la résidence. Votre retour d'expérience, qu'il concerne votre bâtiment ou les espaces communs, contribue à améliorer notre cadre de vie et à nous aider dans le suivi des dossiers de la copropriété.
				</p>
				<p>
					Ensemble, contribuons à faire des Hauts de Nogent une résidence agréable, entretenue et bien informée.
				</p>
			</section>

			<hr>

			<section>
				<h2 class="mb-5">Dernières actualités</h2>

				<div class="flex flex-wrap gap-5 flex-1">
				{
					dernieresActus.map((article) => (
					<article class="rounded-xl px-8 py-6 mb-4 bg-stone-50">
						<h3 class="font-bold">
							<a href={`${baseUrl}/actualites/${article.id}`}>
								{article.data.title}
							</a>
						</h3>
						<p>{article.data.excerpt}</p>
					</article>
					))
				}
				</div>
			</section>
		</Main>
	</main>
</Layout>