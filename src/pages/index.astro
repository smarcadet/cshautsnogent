---
import Layout from '../layouts/Layout.astro';
import Main from '../layouts/Main.astro';
import { Image } from 'astro:assets';
import ProgressTracker from '../components/progress-tracker.astro';

import hero from '../assets/bat_epivans.webp';

import { getCollection } from "astro:content";

const baseUrl = import.meta.env.BASE_URL;
const actualites = await getCollection("actualites");

const dernieresActus = actualites
.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
.slice(0, 3);

const travaux = await getCollection(
  "travaux",
  ({ data }) => data.published
);

const currentWork = travaux
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

<Layout title="Accueil" isHome={true}>
	<main id="main-content">
		<section class="relative h-130 overflow-hidden">
			<div class="text-white bg-black/50 absolute inset-0 z-10 flex content-center justify-center h-full flex-wrap">
				<div class="text-center pt-10">
					<h1 class="text-white text-6xl font-sans font-black text-shadow-sm text-shadow-black">Copropriété des Hauts Nogent</h1>
					<p class="text-2xl text-shadow-sm text-shadow-black">Ensemble pour une résidence agréable à vivre</p>
				</div>
			</div>
			<Image
				src={hero}
				alt="Vue de la façade du bâtiment 2/2bis allée des Epivans"
				class="absolute inset-0 w-full h-full object-cover"
				loading="eager"
				widths={[640, 1024, 1440]}
				sizes="100vw"
			/>
		</section>

		<Main isHome={true}>
			<section>
				<p>
					<strong>Chers copropriétaires,</strong><br><br>
					ce site a pour vocation de vous informer en toute transparence sur les sujets qui concernent notre résidence : décisions votées en Assemblée Générale, les travaux en cours, les actions engagées et les principaux événements de la copropriété.
					Notre objectif est de permettre à chaque copropriétaire de mieux comprendre les actions menées au quotidien pour préserver et améliorer notre cadre de vie.
				</p>
				<p>
					Sur ce site, vous pouvez, via la page <a href={`${baseUrl}/nous-contacter`}>nous contacter</a>, nous signaler tout problème ou dysfonctionnement concernant les parties communes ou présentant un intérêt collectif pour la résidence. Votre retour d'expérience, qu'il concerne votre bâtiment ou les espaces communs, contribue à nous aider dans le suivi des dossiers de la copropriété.<br>
					<strong>N'hésitez pas à vous en servir.</strong>
				</p>
			</section>

			<hr>

			<section>
				<h2 class="pt-0 mb-5">Les dernières actualités</h2>

				<div class="flex flex-wrap gap-5">
				{
					dernieresActus.map((article) => (
					<article class="rounded-lg overflow-hidden mb-4 border-(--secondary) border-2 flex-1 first-of-type:basis-full [&_p]:line-clamp-4 [&:first-of-type_p]:line-clamp-none [&:first-of-type>img]:max-h-80">
						<img
							src={`${baseUrl}${article.data.image ?? "/images/default-article.webp"}`}
							alt=""
							loading="lazy"
							class="object-cover object-top max-h-45 block w-full"
							/>
						<div class="px-8 pt-6">
							<h3 class="font-bold">
								<a href={`${baseUrl}/actualites/${article.id}`}>
									{article.data.title}
								</a>
							</h3>
							<p class="text-base">{article.data.excerpt}</p>
						</div>
					</article>
					))
				}
				</div>

				<div class="mt-10 flex justify-end"><a href={`${baseUrl}/actualites/`} class="cta">Voir toutes les actualités <span aria-hidden="true">&rarr;</span></a></div>
			</section>

			<hr>

			<section>

				<h2 class="pt-0 mb-5">Le chantier mis en avant</h2>

				<h3>
					<a href={`${baseUrl}/suivi-des-travaux/${currentWork.id}`}>
						{currentWork.data.title}
					</a>
				</h3>

				<ProgressTracker
					status={currentWork.data.status}
					blocked={currentWork.data.blocked}
					showProgress={currentWork.data.showProgress}
				/>

				<p class="text-base">{currentWork.data.excerpt}</p>

				<div class="flex justify-end"><a href={`${baseUrl}/suivi-des-travaux/`} class="cta">Voir tous les travaux <span aria-hidden="true">&rarr;</span></a></div>

			</section>

			<hr>

			<section>
				<h2 class="pt-0 mb-5">État d'avancement des dossiers</h2>

				<div class="rounded-lg overflow-hidden border-2 border-(--primary)">
					<table>
						<thead>
							<tr>
								<th scope="col">Dossier</th>
								<th scope="col">Priorité</th>
								<th scope="col">État</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>Départ des gardiens</td>
								<td><span class="block text-center" aria-label="Urgent">🔴</span></td>
								<td>À préparer activement</td>
							</tr>
							<tr>
								<td>Balcons et façade 2/2 bis</td>
								<td><span class="block text-center" aria-label="Urgent">🔴</span></td>
								<td>Bloqué / à relancer</td>
							</tr>
							<tr>
								<td>Réorganisation des services de la résidence</td>
								<td><span class="block text-center" aria-label="Important">🟠</span></td>
								<td>À préparer</td>
							</tr>
							<tr>
								<td>DPE collectif</td>
								<td><span class="block text-center" aria-label="Important">🟠</span></td>
								<td>À vérifier</td>
							</tr>
							<tr>
								<td>Suivi des actions de Cytia par le CS</td>
								<td><span class="block text-center" aria-label="Moyenne">🟡</span></td>
								<td>Permanent</td>
							</tr>
							<tr>
								<td>Canalisations de chauffage vétustes</td>
								<td><span class="block text-center" aria-label="Moyenne">🟡</span></td>
								<td>En attente</td>
							</tr>
							<tr>
								<td>Plan Pluriannuel de Travaux</td>
								<td><span class="block text-center" aria-label="Préparatoire">🔵</span></td>
								<td>En préparation</td>
							</tr>
							<tr>
								<td>Devenir de la loge</td>
								<td><span class="block text-center" aria-label="Préparatoire">🔵</span></td>
								<td>À étudier</td>
							</tr>
						</tbody>
					</table>
				</div>

				<div class="flex justify-end mt-8"><a href={`${baseUrl}/decisions-ag/`} class="cta">Voir tous les dossiers <span aria-hidden="true">&rarr;</span></a></div>
			</section> 
		</Main>
	</main>
</Layout>