---
import Layout from '../layouts/Layout.astro';
import Main from '../layouts/Main.astro';
import { getCollection } from "astro:content";
const baseUrl = import.meta.env.BASE_URL;

const actualites = await getCollection("actualites");

const actualitesTriees = actualites.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title='Actualités'>
    <Main>
        <h1>Actualités</h1>
        
        {
            actualitesTriees.map((article) => (
                <hr />
                <article>
                    <img
                        src={`${baseUrl}${article.data.image ?? "/images/default-article.webp"}`}
                        alt=""
                        loading="lazy"
                        class="object-cover object-[0_-40px] max-h-85 block w-full rounded-lg"
                        />
                    
                    <p class="max-w-max bg-(--accent) text-white px-3.5 py-1.5 rounded-sm absolute -mt-13 ml-3 outline-2 outline-gray-300">
                        {article.data.date.toLocaleDateString("fr-FR")}
                    </p>

                    <h2 class="mt-10">
                        <a href={`${baseUrl}/actualites/${article.id}`}>
                            {article.data.title}
                        </a>
                    </h2>
            
                    <p>{article.data.excerpt}</p>
                </article>
            ))
        }
    </Main>
</Layout>