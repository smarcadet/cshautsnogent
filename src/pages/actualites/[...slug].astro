---
import Layout from "../../layouts/Layout.astro";
import Main from "../../layouts/Main.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection("actualites");

  return articles.map((article) => ({
    params: {
      slug: article.id,
    },
    props: {
      article,
    },
  }));
}

const { article } = Astro.props;

const { Content } = await render(article);
---

<Layout title={article.data.title}>
    <Main>
        <article class="articles relative">

            <p class="absolute -right-3.5 -top-23 min-w-max bg-(--accent) text-white px-3.5 py-1.5 rounded-sm">Le <strong>{article.data.date.toLocaleDateString("fr-FR")}</strong></p>

            <h1>{article.data.title}</h1>

            <Content />

        </article>
    </Main>
</Layout>
