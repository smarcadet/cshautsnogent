---
import Layout from '../../layouts/Layout.astro';
import Main from '../../layouts/Main.astro';
import { getCollection, render } from "astro:content";
import ProgressTracker from '../../components/progress-tracker.astro';

export async function getStaticPaths() {
  const travaux = await getCollection("travaux");

  return travaux.map((chantier) => ({
    params: {
      slug: chantier.id,
    },
    props: {
      chantier,
    },
  }));
}

const { chantier } = Astro.props;

const { Content } = await render(chantier);
---

<Layout title={chantier.data.title}>
    <Main>
        <article class="articles relative">

            <p class="absolute -left-14 -top-7 min-w-max bg-(--accent) text-white px-3.5 py-1.5 rounded-sm">
                Le <strong>{chantier.data.date.toLocaleDateString("fr-FR")}</strong>
            </p>

            <h1 class="pl-26">
                {chantier.data.title}
            </h1>

            <ProgressTracker
                status={chantier.data.status}
                blocked={chantier.data.blocked}
                showProgress={chantier.data.showProgress}
            />

            <p><strong>{chantier.data.excerpt}</strong></p>

            <Content />

        </article>
    </Main>
</Layout>