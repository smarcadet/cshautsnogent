---
import { navigation } from "../data/navigation";
import { Image } from "astro:assets";

import logo from "../assets/identity/CS_hauts_nogent.jpg";

const { isHome = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const leftLinks = navigation.slice(0, 3);
const rightLinks = navigation.slice(3);

const getHref = (href: string) =>
  href
    ? `${baseUrl}/${href}`
    : baseUrl;
---

<nav class="w-full">
  <div class:list={[
    "grid grid-cols-[1fr_auto_1fr] before:inset-0 before:block before:-z-1 before:h-28 items-center before:absolute",
    isHome ? "before:bg-black/40" : "before:bg-black/80"]}>
    <ul class="flex justify-end gap-6 mb-9">
      {
        leftLinks.map((link) => {
          const href = getHref(link.href);
          const isActive = currentPath === href;

          return (
            <li>
              <a href={href}
                class:list={[
                  "relative nav-link block px-4 py-4 transition-colors hover:text-(--surface) hover:after:border-b-3 after:absolute after:text-(--surface) after:top-full after:inset-x-0 font-bold text-base",
                  isActive ? "text-(--surface) after:border-b-3" : "text-white",
                ]}>

                {link.label}

              </a>
            </li>
          );
        })
      }
    </ul>

    <a href={baseUrl} aria-label="Retour à l'accueil" aria-describedby="tooltip-accueil" class="flex justify-center py-0.5 px-2.5 bg-white rounded-xl mx-6 mt-4 tooltip-container shadow-xl">
        <Image src={logo} alt="Logo du Conseil Syndical des Hauts de Nogent" class="w-30" loading="eager" />

        <div id="tooltip-accueil" role="tooltip" class="tooltip bottomleft">
          Retour à l'accueil
        </div>
    </a>

    <ul class="flex justify-start gap-6 mb-9">
      {
        rightLinks.map((link) => {
          const href = getHref(link.href);
          const isActive = currentPath === href;

          return (
            <li>
              <a href={href}
                class:list={[
                  "relative nav-link block px-4 py-4 transition-colors hover:text-(--surface) hover:after:border-b-3 after:absolute after:top-full after:text-(--surface) after:inset-x-0 font-bold text-base",
                  isActive ? "text-(--surface) after:border-b-3" : "text-white",
                ]}>

                {link.label}

              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>