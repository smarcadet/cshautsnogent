---
import {
    steps,
    statusLabels,
    getStepState,
    statusIcons,
    stateLabels,
} from "../utils/travaux";

interface Props {
    status: any;
    blocked?: boolean;
    progress?: number;
    showProgress?: boolean;
}

const {
    showProgress = true,
} = Astro.props;

if (!showProgress) {
    return null;
}

const {
    status,
    blocked = false,
} = Astro.props;
---

<ol class="progress-tracker">

    {
        steps.map((step) => {

            const state = getStepState(
                status,
                step,
                blocked
            );

            return (
                <li class={`progress-step ${state}`} aria-label={`${statusLabels[step]} : ${stateLabels[state]}`}>

                    <div class="progress-icon">
                        {statusIcons[state]}
                    </div>

                    <div class="progress-label">
                        {
                            state === "blocked"
                                ? "Dossier bloqué"
                                : statusLabels[step]
                        }
                    </div>

                </li>
            );
        })
    }

</ol>