---
import { Image } from "astro:assets";
import logo from "../assets/identity/CS_hauts_nogent.jpg";

const baseUrl = import.meta.env.BASE_URL;
---

<footer class="flex items-center justify-center bg-black/80 px-4 py-8 text-white" class="footer">
    <a href={baseUrl} aria-label="Retour à l'accueil" aria-describedby="tooltip-accueil" class="flex justify-center py-0.5 px-2.5 bg-white rounded-xl mx-6 mt-4 tooltip-container shadow-xl">
        <Image src={logo} alt="Logo du Conseil Syndical des Hauts de Nogent" class="w-30" loading="eager" />

        <div id="tooltip-accueil" role="tooltip" class="tooltip topright">
          Retour à l'accueil
        </div>
    </a>
    <ul class="list-none flex items-center gap-6 mr-5">
        <li class="before:content-['|'] before:mr-5"><a class="nav-link" href={`${baseUrl}/nous-contacter`}>Nous contacter</a></li>
        <li class="before:content-['|'] before:mr-5">Accessibilité : partiellement conforme</li>
        <li class="before:content-['|'] before:mr-5"><span>Copyright</span> 2026</li>
    </ul>
</footer>